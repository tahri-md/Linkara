{
  "name": "linkara-cicd-pipeline",
  "version": "1.0.0",
  "description": "CI/CD Pipeline Builder - Enterprise-grade workflow automation platform",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec 'npx tsx' src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc && mkdir -p dist/db/migrations dist/graphql/types && cp src/db/migrations/*.sql dist/db/migrations/ && cp src/graphql/types/*.graphql dist/graphql/types/",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "db:migrate": "npx tsx src/db/migrations/run.ts",
    "db:seed": "npx tsx src/db/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tahri-md/Linkara.git"
  },
  "keywords": [
    "cicd",
    "pipeline",
    "devops",
    "workflow",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tahri-md/Linkara/issues"
  },
  "homepage": "https://github.com/tahri-md/Linkara#readme",
  "dependencies": {
    "@apollo/server": "^4.7.0",
    "@slack/web-api": "^6.8.1",
    "apollo-server-express": "^3.12.0",
    "axios": "^1.4.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.10.4",
    "bullmq": "^5.76.1",
    "dockerode": "^4.0.12",
    "dotenv": "^16.3.1",
    "execa": "^9.6.1",
    "express": "^4.18.2",
    "graphql": "^16.6.0",
    "graphql-subscriptions": "^2.0.0",
    "graphql-ws": "^5.12.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.0",
    "nodemailer": "^6.9.1",
    "pg": "^8.10.0",
    "redis": "^4.6.0",
    "uuid": "^9.0.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/node": "^20.5.1",
    "@types/nodemailer": "^6.4.12",
    "@types/pg": "^8.10.7",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.2",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "jest": "^29.6.4",
    "jiti": "^2.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}