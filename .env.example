# =============================================================================
# Linkara backend — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Database (all read individually — DATABASE_URL is NOT used) ----------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=linkara_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# --- Redis (job queue via BullMQ / ioredis) ---------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Server ------------------------------------------------------------------
PORT=4000
API_BASE_URL=http://localhost:4000
# Used for links generated in emails/notifications (e.g. invite links)
APP_BASE_URL=http://localhost:3000

# --- JWT (REQUIRED — server exits on boot if unset) -------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION=24h

# --- Encryption (REQUIRED — server exits on boot if unset) ------------------
# Used to encrypt secrets stored via SecretsService. Generate with e.g.:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# --- Email / notifications --------------------------------------------------
EMAIL_FROM=noreply@example.com
EMAIL_SERVICE=gmail
EMAIL_USER=
# Use a Gmail "App Password", never your real account password.
# https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=

# --- Docker (used to run pipeline jobs) -------------------------------------
DOCKER_HOST=unix:///var/run/docker.sock

# --- Queue / worker tuning (optional — sensible defaults if unset) ----------
JOB_EXECUTION_CONCURRENCY=5
LOG_PROCESSING_CONCURRENCY=5
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_DEFAULT_BACKOFF_MS=5000

# =============================================================================
# Reserved for planned integrations — not yet read by the codebase.
# Safe to leave blank until those features are wired up.
# =============================================================================
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=linkara-artifacts