# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linkara_dev
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=linkara_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h

# GitHub Integration
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Slack Integration
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@linkara.dev

# AWS Configuration (for deployments and artifact storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=linkara-artifacts

# Docker Configuration
DOCKER_HOST=unix:///var/run/docker.sock

# Encryption Configuration (for secrets)
ENCRYPTION_KEY=your-32-character-encryption-key

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:3000

# Development
DEBUG=linkara:*
